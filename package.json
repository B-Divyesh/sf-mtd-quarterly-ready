{
  "name": "mtd-quarterly-ready",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "serve": "cargo run --release",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:rust": "cargo test",
    "test:deploy-contract": "node scripts/check-deploy-contract.mjs",
    "verify:url": "bash scripts/verify-url.sh",
    "verify:concurrency": "node scripts/verify-concurrent-workspaces.mjs",
    "verify:rate-limit": "node scripts/verify-rate-limit.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:release": "VERIFY_AZURE_TOPOLOGY=1 REQUIRE_APPROVED_HMRC=1 node scripts/verify-live.mjs",
    "verify:topology": "bash scripts/verify-azure-topology.sh",
    "test": "npm run typecheck && npm run test:unit && npm run test:rust && npm run test:deploy-contract && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/node": "24.10.1",
    "@playwright/test": "1.58.2",
    "playwright-core": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
